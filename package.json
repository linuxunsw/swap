{
	"name": "subcom-application",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev --env production",
		"preview:mode:dev": "pnpm run build --mode development && wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"deploy": "pnpm run build && wrangler deploy --env production",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@better-auth/drizzle-adapter": "^1.6.23",
		"@cloudflare/workers-types": "^4.20260702.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.39.4",
		"@internationalized/date": "^3.12.2",
		"@libsql/client": "^0.17.4",
		"@lucide/svelte": "^1.23.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.69.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^24.13.2",
		"@types/pg": "^8.20.0",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"formsnap": "^2.0.1",
		"globals": "^17.7.0",
		"pg": "^8.22.0",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"resend": "^6.16.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"svelte-sonner": "^1.1.1",
		"sveltekit-flash-message": "^2.4.6",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.62.1",
		"valibot": "^1.4.2",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^7.3.6",
		"vitest": "^4.1.9",
		"wrangler": "^4.106.0"
	},
	"packageManager": "pnpm@10.28.2",
	"dependencies": {
		"mode-watcher": "^1.1.0"
	}
}

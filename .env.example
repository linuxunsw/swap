# Used for local development and Drizzle migrations
# For example: postgresql://username:password@localhost:5432/swap
DATABASE_URL=""

# Cloudflare Hyperdrive - local via miniflare
# This is just a DB url which is used when running wrangler dev. When working
# locally, it should be the same as `DATABASE_URL`.
# see: https://developers.cloudflare.com/hyperdrive/configuration/local-development/
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=""

# URL where the app is hosted. For dev, this will be http://localhost:5173/
ORIGIN="http://localhost:5173/"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
# A secret can be generated by running `npx auth secret`
BETTER_AUTH_SECRET=""

# Better Auth Sessions
# values are in seconds
# Not required in dev.
BETTER_AUTH_SESSION_EXPIRES_IN=""
BETTER_AUTH_SESSION_UPDATE_AGE=""

# admin allowlist
# comma seperated list of administrator zids.
# If you are developing, you may wish to add your own zID here.
ADMIN_ZIDS=""

# Logging
# toggles whether values marked devOnly are included in logs
# set to false in production
LOG_DEV_ONLY="true"
LOG_DEBUG="true"

# Emails
# In dev, these emails will be logged to the console instead, so these don't
# need to be configured.
RESEND_API_KEY=""
MAILER_FROM_EMAIL=""
CONSOLE_MAILER="true"

# OTP
OTP_EXPIRY_MINS="5"

# Rate Limiting
# this is a fallback and used ONLY if the binding is unavailable
RATE_LIMIT_BYPASS="true"

# Cloudflare Turnstile
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# These example keys cause Cloudflare to auto-accept (useful for dev)
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Public society details for display (e.g in contact/FAQ)
PUBLIC_SOCIETY_EMAIL=""
PUBLIC_SOCIETY_WEBSITE=""
PUBLIC_SWAP_GITHUB=""
